# URL canónica
SITE_URL=https://www.iglesiapilar.mx

# Fuente editorial durante la transición: notion | payload
CONTENT_SOURCE=notion

# Payload CMS. En producción DATABASE_URL apunta a Neon PostgreSQL.
DATABASE_URL=
PAYLOAD_SECRET=
PAYLOAD_FROM_EMAIL=sitio@iglesiapilar.mx
PAYLOAD_DB_PUSH=false

# Traducción automática al publicar contenido en español.
# Las llaves gratuitas de DeepL terminan en :fx.
DEEPL_API_KEY=

# Tooltips de referencias bíblicas mediante API.Bible.
BIBLE_API_KEY=

# Notion
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=349de065-6c3e-80db-b431-000b11c998e7
NOTION_WEBHOOK_VERIFICATION_TOKEN=
NOTION_API_VERSION=2025-09-03
# Permite que la migración escriba el ID y estado de Payload de vuelta en Notion.
# Actívalo únicamente cuando la conexión tenga permiso "Update content".
NOTION_WRITEBACK_ENABLED=false

# Protege la sincronización diaria de Vercel Cron. Usa 16 caracteres o más.
CRON_SECRET=

# Vercel Blob: habilita snapshots estables y copia de medios
BLOB_READ_WRITE_TOKEN=

# QStash ejecuta publicaciones programadas cada cinco minutos
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Formulario de contacto
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Iglesia Pilar <sitio@iglesiapilar.mx>

# Dar en línea (Stripe Checkout). La sección es visible por defecto.
# Usar sk_test_ en staging y sk_live_ únicamente después de validar el flujo completo.
STRIPE_SECRET_KEY=
# Opcionales; si se omiten se derivan de SITE_URL.
STRIPE_GIVE_SUCCESS_URL=
STRIPE_GIVE_CANCEL_URL=

# Analítica
NEXT_PUBLIC_GA_MEASUREMENT_ID=
ENABLE_ENGLISH_LOCALE=false
